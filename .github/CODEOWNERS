# Code owners define the supervision boundary for agent-authored pull requests.
#
# Branch protection on `main` requires a Code Owner review, with no blanket
# approval count. A pull request that touches none of these paths can therefore
# be auto-merged once CI is green; anything listed here needs @DevilTea.
#
# Refresh the protection settings with: pnpm setup:guardrails

# CI, release automation, and the enforced agent boundary. An agent must not be
# able to weaken the gates that constrain it.
/.github/                    @DevilTea
/.claude/                    @DevilTea
/.agents/                    @DevilTea
/scripts/                    @DevilTea

# Always-on instruction sources and the published consumer skill.
/AGENTS.md                   @DevilTea
/CLAUDE.md                   @DevilTea
/CONTRIBUTING.md             @DevilTea
/RELEASING.md                @DevilTea
/SECURITY.md                 @DevilTea
/SUPPORT.md                  @DevilTea
/MIGRATION.md                @DevilTea
/skills/                     @DevilTea

# Dependency and supply-chain policy: `minimumReleaseAge`, `trustPolicy`,
# `overrides`, and the catalog. Adding or loosening a dependency is an owner
# decision, never a side effect of a fix.
/package.json                @DevilTea
/pnpm-workspace.yaml         @DevilTea
/pnpm-lock.yaml              @DevilTea

# Toolchain configuration.
/eslint.config.mjs           @DevilTea
/tsconfig.json               @DevilTea
/tsconfig.scripts.json       @DevilTea
/vitest.config.ts            @DevilTea

# Published package contracts: exports, engines, files, type entry points.
/packages/*/package.json     @DevilTea
