{
	"extends": "./tsconfig.package.json",
	"compilerOptions": {
		"composite": true
	},
	"include": [
		"./src/**/*.ts",
		"./vitest.config.ts",
		"../_shared/vitest.ts"
	],
	// Neutralize the inherited package-config exclude: without this, the
	// parent's "exclude" of *.test.ts silently cancels the include above and
	// this project checks zero test files.
	"exclude": []
}
